# Modelo do .env (este arquivo vai para o git; o .env de verdade não).
# Copie para .env na raiz do repositório e preencha as chaves.

# Interpretador de mensagens (ADR 0007): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Transcrição pelo Groq (ADR 0006): https://console.groq.com/keys
# Antes de usar com voz de alguém, ligue a retenção zero em Settings > Data Controls.
GROQ_API_KEY=

# Comparação com a Google Places (python -m base comparar-google, ADR 0005)
GOOGLE_PLACES_API_KEY=
