# Modelo de variáveis de ambiente (.env de verdade fica fora do git)

# Interpretador de mensagens (ADR 0007)
OPENROUTER_API_KEY=

# Transcrição pelo Groq (ADR 0006)
GROQ_API_KEY=

# Comparação com Google Places (ADR 0005)
GOOGLE_PLACES_API_KEY=

# Observabilidade e Telemetria (Langfuse Cloud)
ENVIRONMENT=desenvolvimento
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
