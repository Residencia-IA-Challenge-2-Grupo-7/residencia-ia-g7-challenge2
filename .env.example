# Modelo de variáveis de ambiente (.env de verdade fica fora do git)

# Interpretador de mensagens (ADR 0007) e LLM pura da comparação da semana 3 (ADR 0010)
OPENROUTER_API_KEY=
# Opcional: outro modelo da OpenRouter para o Modo A (padrão: deepseek/deepseek-v4.1-flash-1017)
LLM_PURA_MODELO=

# Transcrição pelo Groq (ADR 0006)
GROQ_API_KEY=

# Comparação com Google Places (ADR 0005)
GOOGLE_PLACES_API_KEY=

# Observabilidade e Telemetria (Langfuse Cloud)
ENVIRONMENT=desenvolvimento
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
