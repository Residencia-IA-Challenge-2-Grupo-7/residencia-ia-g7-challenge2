# Banco de Dados PostgreSQL (Local via Docker Compose)
BASE_PG_SENHA=base_local
BASE_DSN=postgresql://base:base_local@base-pg:5432/base

# Observabilidade e Telemetria (Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-seu-public-key
LANGFUSE_SECRET_KEY=sk-lf-seu-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# APIs Externas (opcionais na Semana 2)
OPENROUTER_API_KEY=
GOOGLE_PLACES_API_KEY=
